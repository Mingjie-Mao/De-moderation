# Non-secret Northflank demo overrides. Import existing secrets separately.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=10000
MANAGEMENT_SERVER_PORT=10000
EXPOSE_PROMETHEUS=false
EXPOSE_API_DOCS=false
MAIL_ENABLED=false
MEDIA_BACKEND=S3
MEDIA_SWEEP_ENABLED=false
INVESTIGATOR_ENABLED=false
CAMPUSGUARD_MODERATION_SCHEDULER_ENABLED=true
CAMPUSGUARD_MODERATION_POLL_INTERVAL=30m
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=0
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=600000
SPRING_DATASOURCE_HIKARI_KEEPALIVE_TIME=0
JAVA_TOOL_OPTIONS=-Djava.awt.headless=true -XX:MaxRAMPercentage=60 -XX:+ExitOnOutOfMemoryError
CORS_ALLOWED_ORIGINS=https://de-moderation-review-demo.pages.dev
PUBLIC_URL=https://p01--de-moderation-api--z48dx52bgz5k.code.run

DB_POOL_SIZE=5
DB_MIN_IDLE=0
